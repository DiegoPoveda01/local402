# Every variable is documented in docs/facilitator.md. Only FACILITATOR_PRIVATE_KEYS is required on testnet.

# Fee-paying accounts ("channels"), comma-separated: one per settlement that can run at the same time.
# `local402-facilitator keys` fills this line with fresh testnet accounts. Never share them with another instance.
# FACILITATOR_PRIVATE_KEY (a single key) still works; FACILITATOR_PRIVATE_KEYS wins when both are set.
FACILITATOR_PRIVATE_KEYS=
# stellar:testnet or stellar:pubnet
NETWORK=stellar:testnet
# The FxPay contract. Defaults to the Local402 testnet deployment; required on stellar:pubnet.
FX_CONTRACT=
# Token contracts payers may spend through exact-fx. Defaults to the network's XLM and EURC.
SEND_ASSETS=
# Soroban RPC. Defaults to the public testnet RPC, or https://mainnet.sorobanrpc.com on stellar:pubnet.
RPC_URL=
PORT=4022

# Who this instance settles for, and from how much (token units, 7 decimals: 100000 is 0.01 USDC).
# Empty on testnet means any seller. On stellar:pubnet PAY_TO_ALLOWLIST is required and MIN_AMOUNT defaults to 100000.
PAY_TO_ALLOWLIST=
MIN_AMOUNT=
# Token contracts (C...) a seller may be paid in. Empty on testnet means any token; on stellar:pubnet it
# defaults to USDC, XLM and EURC, so a token anyone can mint cannot meet MIN_AMOUNT.
ASSET_ALLOWLIST=

# Requests per client per minute. Verify only simulates; settle spends this instance's XLM.
VERIFY_RATE_LIMIT=60
SETTLE_RATE_LIMIT=20
# /ready answers 503 when a fee payer holds less than this many XLM.
MIN_FEE_BALANCE_XLM=2
# Proxies in front of this instance (load balancer, edge). Leave 0 when clients connect directly:
# trusting a proxy that is not there lets any client pick its own address and dodge the limits.
TRUST_PROXY=0
