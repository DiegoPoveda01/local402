FACILITATOR_PRIVATE_KEY=S...
# Optional: several comma-separated fee-paying accounts settle in parallel (overrides FACILITATOR_PRIVATE_KEY)
FACILITATOR_PRIVATE_KEYS=
# stellar:testnet or stellar:pubnet
NETWORK=stellar:testnet
# Defaults to the Local402 FxPay testnet deployment with the XLM and tstEURC SACs; required on mainnet
FX_CONTRACT=
# Optional Soroban RPC; mainnet defaults to https://mainnet.sorobanrpc.com
RPC_URL=
SEND_ASSETS=
PORT=4022
