# Payer account: a stellar-cli identity (preferred) or a raw testnet secret key
STELLAR_IDENTITY=local402-agent
# STELLAR_PRIVATE_KEY=S...
# Default payment asset: USDC (stock exact scheme), XLM or EURC (exact-fx, swapped to USDC by FxPay)
PAY_WITH=XLM
# Spending limits in any supported currency, per payment, per day (from local midnight) and in total.
# Periods left out keep their defaults: 500 CLP/payment, 2000 CLP/day, 5000 CLP/total
LIMITS=500 CLP/payment, 2000 CLP/day, 5000 CLP/total
# Payment history the daily and total limits are counted from. Defaults to
# ~/.local402/history-<testnet|pubnet>-<address>.jsonl
# LOCAL402_HISTORY=
# Facilitator whose x402 Bazaar catalog local402_discover lists. Defaults to the public Local402 facilitator:
# stellar:testnet → https://local402.vercel.app/facilitator, stellar:pubnet → https://local402-mainnet.vercel.app/facilitator
# FACILITATOR_URL=http://localhost:4022
# stellar:testnet (default) or stellar:pubnet; anything else is refused. On mainnet, FX_CONTRACT defaults to
# the Local402 FxPay deployment.
NETWORK=stellar:testnet
FX_CONTRACT=
# Optional: Horizon used to read balances. Defaults to the network's public instance.
HORIZON_URL=
