# Seller Stellar address (needs a USDC trustline)
PAY_TO=G...
NETWORK=stellar:testnet
FACILITATOR_URL=http://localhost:4022
PORT=3001
# Optional: secret of a funded testnet account, enables the dashboard's "pay as an agent" buttons
DEMO_AGENT_SECRET=
# Optional: dashboard origins allowed to pay from the visitor's wallet, comma-separated (e.g. https://local402.vercel.app)
CORS_ORIGIN=
# Public URL of this API, used by the demo agent to buy from it. Defaults to the Vercel project's
# production domain, and to the request's host only when that host is localhost.
SELF_URL=
# Optional: cap on what the shared demo wallet will pay for one resource (default "1000 CLP")
DEMO_MAX_PRICE=
# Optional: Redis key for receipts, when several deployments share one store
RECEIPTS_KEY=
