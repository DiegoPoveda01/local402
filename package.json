{
  "name": "local402",
  "private": true,
  "description": "x402 on Stellar priced in local currency (CLP, EUR, BRL...) and payable with any asset",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p examples/quickstart",
    "demo": "tsx scripts/demo.ts",
    "api": "npm run dev -w @local402/demo-api",
    "agent": "npm run start -w @local402/agent",
    "facilitator": "npm run start -w @local402/facilitator",
    "mcp": "npm run start -w @local402/mcp"
  },
  "devDependencies": {
    "@stellar/freighter-api": "^6.0.1",
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.0",
    "local402-client-0.1": "npm:local402-client@0.1.3",
    "local402-fx-0.1": "npm:local402-fx@0.1.2",
    "local402-pricing-0.1": "npm:local402-pricing@0.1.4",
    "local402-server-0.1": "npm:local402-server@0.1.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
